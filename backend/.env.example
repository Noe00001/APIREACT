# ==============================================================================
# VARIABLES DE ENTORNO — BACKEND FASTAPI (CAFÉ CATO)
# ==============================================================================

# 1. Configuración de Base de Datos (MySQL o SQLite)
# Si no hay MySQL corriendo, el sistema usará automáticamente SQLite persistente (cafe_cato.db)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cafe_cato
# DATABASE_URL=sqlite:///./cafe_cato.db

# 2. Seguridad y JWT
SECRET_KEY=cafe_cato_super_secret_key_2024_fastapi_jwt_produccion_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 3. Integración con Inteligencia Artificial (Criterio 7)
# Opcional: Si se deja en blanco, se utiliza el motor heurístico-semántico propio integrado
AI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
